# ============================================================
# LSB FOOTBALL BETTING BOT - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and update the values.
# Never commit your actual .env file to version control!
# ============================================================

# ============================================================
# TELEGRAM CONFIGURATION
# ============================================================

# Your Telegram Bot Token from @BotFather
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Your Telegram Chat ID (can be your personal ID or group ID)
# To get your ID: send /start to @userinfobot
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ============================================================
# FIREBASE CONFIGURATION
# ============================================================

# Firebase service account credentials as a JSON string
# This is the entire service account JSON file content
# Example: {"type": "service_account", "project_id": "..."}
# Keep the JSON on a single line or use triple quotes
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"1234567890","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# ============================================================
# STAKING ENGINE CONFIGURATION
# ============================================================

# Initial bankroll for the staking engine (default: 1000)
INITIAL_BANKROLL=1000

# ============================================================
# SERVER / PORT CONFIGURATION
# ============================================================

# Port for Prometheus metrics endpoint (default: 8000)
# Railway automatically sets PORT, so this should work without changes
PORT=8000

# ============================================================
# LOGGING CONFIGURATION
# ============================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================
# BOT OPERATIONAL PARAMETERS
# ============================================================

# Sleep time between bot cycles (seconds)
# Default: 55 (recommended for live match monitoring)
SLEEP_TIME=55

# Maximum chase level for fallback Martingale (if staking engine disabled)
# Default: 3 (1, 2, 4, 8)
MAX_CHASE_LEVEL=3

# Original stake for fallback Martingale (if staking engine disabled)
# Default: 10
ORIGINAL_STAKE=10

# ============================================================
# MATCH FILTERING PARAMETERS
# ============================================================

# Minutes to check for bet placement (typically 35, 36, 37)
MINUTES_REGULAR_BET=35,36,37

# Keywords to skip (amateur, youth, reserves, etc.)
AMATEUR_KEYWORDS=amateur,youth,reserves,u18,u17,u16,u19,u22,u23,u21,u20,college

# ============================================================
# PERFORMANCE / WATCHDOG
# ============================================================

# Watchdog limit - max cycle time in seconds (default: 300 = 5 minutes)
WATCHDOG_LIMIT=300

# Reboot limit - auto-restart after this many seconds (default: 86400 = 24 hours)
REBOOT_LIMIT=86400

# Heartbeat limit - send status update every X seconds (default: 3600 = 1 hour)
HEARTBEAT_LIMIT=3600

# Status update interval - send staking status every X cycles (default: 30)
STATUS_UPDATE_INTERVAL=30

# Memory prune timeout - clean up stale matches after X seconds (default: 5400 = 90 minutes)
MEMORY_PRUNE_TIMEOUT=5400

# Predict start minute - start monitoring from this minute (default: 30)
PREDICT_START_MIN=30

# Pre-warm window - check matches in this minute range (default: 34-38)
PRE_WARM_WINDOW_MIN=34
PRE_WARM_WINDOW_MAX=38

# ============================================================
# PROMETHEUS METRICS
# ============================================================

# Enable/disable Prometheus metrics (default: true)
# Set to false if you don't want to expose metrics
PROMETHEUS_ENABLED=true

# ============================================================
# STAKING ENGINE - OPTIONAL OVERRIDES
# ============================================================

# WARNING: These are advanced settings. Only change if you know what you're doing.
# The staking engine uses: 10, 15, 25, 40, 60, 90
# Override by setting a comma-separated list:
# CUSTOM_STAKE_SEQUENCE=10,15,25,40,60,90

# Pause duration after 3 consecutive losses (seconds)
# Default: 3600 (1 hour)
# PAUSE_DURATION=3600

# Maximum consecutive losses before pause
# Default: 3
# MAX_CONSECUTIVE_LOSSES=3

# Betting odds (default: 1.45)
# ODDS=1.45

# ============================================================
# DEBUG / TESTING
# ============================================================

# Enable dry-run mode (no actual bets placed)
# DRY_RUN=false

# Enable verbose logging for debugging
# DEBUG_VERBOSE=false

# ============================================================
# END OF CONFIGURATION
# ============================================================
